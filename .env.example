# Webhook receiver; leave empty to only collect into SQLite
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=
# Alert channel: POST {"text": "..."} (Slack-style incoming webhook, etc.)
MAX_ALERT_URL=
MAX_HISTORY_DAYS=30
MAX_HISTORY_RPS=1
# Chat filter: comma-separated chat ids / types (dialog,group,channel)
MAX_CHATS_ALLOW=
MAX_CHATS_DENY=
MAX_CHAT_TYPES=dialog,group,channel
# 0 = keep forever
MAX_RETENTION_DAYS=0
MAX_LOG_LEVEL=INFO
